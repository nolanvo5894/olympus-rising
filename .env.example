# Local dev only — Vite inlines this into the client bundle, so DO NOT use
# this variable in production. The Cloud Run deploy reads GEMINI_API_KEY
# (server-side only, see server.js) from Secret Manager.
#
# Get a key at https://aistudio.google.com/apikey
VITE_GEMINI_API_KEY=

# Server-side key used by server.js when running `npm start` or in the
# Cloud Run container. In dev with `npm run dev` (Vite), the client uses
# VITE_GEMINI_API_KEY directly and this is ignored.
GEMINI_API_KEY=
